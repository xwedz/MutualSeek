# Copy this file to .dev.vars and fill in your own values. The Worker reads it during local development (npm run dev).
# .dev.vars must never be committed (.gitignore already excludes it).
# Production doesn't use this file; set secrets with: npx wrangler secret put <NAME>

# Create an OAuth application at the bottom of https://osu.ppy.sh/home/account/edit to get these.
OSU_CLIENT_ID=your_client_id_here
OSU_CLIENT_SECRET=your_client_secret_here

# Key for signing the login cookie. Use a long random string, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change_this_to_a_long_random_string

# Key for encrypting osu! tokens in the database (AES-256-GCM); must be exactly 32 bytes, base64url encoded.
# Generate it the same way (randomBytes(32)). If this key is lost or changed, stored tokens stop working and users must log in again.
TOKEN_ENCRYPTION_KEY=change_this_to_32_random_bytes_base64url

# Use a separate, new SESSION_SECRET and TOKEN_ENCRYPTION_KEY in production; don't share them with local development.

# Local development only: the frontend runs on Vite (5173) and the API on wrangler (3000), so the login URLs are set explicitly.
# This redirect URI must be registered as a Callback URL in your osu! OAuth application.
# Don't set these two in production (the Worker uses the site's own URL).
OSU_REDIRECT_URI=http://localhost:3000/api/auth/callback
FRONTEND_URL=http://localhost:5173
