{
    "$schema": "node_modules/wrangler/config-schema.json",
    // Worker name, which also sets the workers.dev URL (mutualseek.<account subdomain>.workers.dev)
    "name": "mutualseek",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-01",

    // The site's address. Cloudflare creates the DNS record and HTTPS certificate for it.
    // The OAuth callback follows the address in use (see src/auth.ts), so production's osu! OAuth app must list
    // https://mutualseek.xwedz.dev/api/auth/callback as its callback URL.
    "routes": [{ "pattern": "mutualseek.xwedz.dev", "custom_domain": true }],
    "workers_dev": false,

    // The frontend (client/dist) is served by Cloudflare directly; static assets are free and don't count as requests.
    // Only /api/* runs the Worker; other paths without a file get index.html (single-page application).
    "assets": {
        "directory": "./client/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
    },

    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "osu-mutual-tool",
            // The production database created with `npx wrangler d1 create osu-mutual-tool` (local --local runs don't use this id)
            "database_id": "09bc6e1a-8245-49b0-a547-ae85e6d477ce",
            "migrations_dir": "migrations"
        }
    ],

    // Per-IP rate limit against a single source hammering the API. period can only be 10 or 60 seconds.
    "ratelimits": [
        {
            "name": "API_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 60, "period": 60 }
        }
    ],

    // Background scanner: runs every minute and does a small batch each time (see src/crawler.ts).
    "triggers": { "crons": ["* * * * *"] },

    // Workers Logs: see each run's logs and errors in the Cloudflare dashboard (e.g. exceeding the CPU limit).
    // The free plan keeps 200,000 events a day for 3 days; the scanner's ~1,440 runs a day use very little of it.
    "observability": { "enabled": true, "head_sampling_rate": 1 },

    "vars": {
        // What to scan: "all" = every country (most active players first),
        // or comma-separated country codes such as "TW,JP". Only osu! standard mode is scanned.
        "SCAN_COUNTRIES": "all",
        "SCAN_MODE": "osu",
        // Pause scanning: "now" = right away; a country code = once that country (including its last page) is done this pass; empty = don't pause
        "SCAN_PAUSE": "now"
    }

    // Don't put secrets here:
    //   locally: in .dev.vars (gitignored), see .dev.vars.example for the format
    //   production: npx wrangler secret put OSU_CLIENT_ID (and likewise for the other secrets)
}
