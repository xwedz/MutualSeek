{
    "$schema": "node_modules/wrangler/config-schema.json",
    // Worker 名稱，也決定 workers.dev 的網址（mutualseek.<帳號子網域>.workers.dev）
    "name": "mutualseek",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-01",

    // 前端（client/dist）由 Cloudflare 直接提供，靜態檔案免費且不計入請求額度。
    // 只有 /api/* 會執行 Worker；其他路徑找不到檔案時回傳 index.html（單頁應用程式）。
    "assets": {
        "directory": "./client/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
    },

    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "osu-mutual-tool",
            // `npx wrangler d1 create osu-mutual-tool` 建立的線上資料庫（本機開發 --local 不會用到這個值）
            "database_id": "09bc6e1a-8245-49b0-a547-ae85e6d477ce",
            "migrations_dir": "migrations"
        }
    ],

    // 每個 IP 的頻率限制，擋單一來源猛刷 API。period 只能是 10 或 60 秒。
    "ratelimits": [
        {
            "name": "API_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 60, "period": 60 }
        }
    ],

    // 背景掃描：每分鐘跑一次，每次只做一小批（見 src/crawler.ts 的說明）。
    "triggers": { "crons": ["* * * * *"] },

    // Workers Logs：在 Cloudflare 儀表板查看每次執行的紀錄與錯誤（例如超過 CPU 時間限制）。
    // 免費方案每天 20 萬筆、保留 3 天；背景掃描每天約 1,440 次執行，用量很小。
    "observability": { "enabled": true, "head_sampling_rate": 1 },

    "vars": {
        // 掃描範圍："all" = 所有國家（依活躍玩家數從多到少逐國掃描），
        // 也可以填逗號分隔的國家代碼，例如 "TW,JP"。目前只掃 osu! 標準模式。
        "SCAN_COUNTRIES": "all",
        "SCAN_MODE": "osu"
    }

    // 機密值不要寫在這裡：
    //   本機：放在 .dev.vars（已加入 .gitignore），格式見 .dev.vars.example
    //   線上：npx wrangler secret put OSU_CLIENT_ID（其他機密值同理）
}
