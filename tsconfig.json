{
    // TypeScript settings for the backend (Worker); the frontend has its own in client/.
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        // Workers aren't browsers: no DOM types; worker-configuration.d.ts (from npm run cf-typegen) is used instead
        "lib": ["ES2022"],
        "types": [],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["src/**/*.ts", "worker-configuration.d.ts"]
}
